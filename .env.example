# Address the HTTP/WebSocket server binds to.
HOST=0.0.0.0

# Port the server listens on.
PORT=3000

# Shared secret required from clients (?token= or Authorization: Bearer).
# Leave empty to disable authentication.
TOKEN=

# Maximum number of Chromium sessions running at the same time.
MAX_CONCURRENT_SESSIONS=10

# Maximum number of extra requests allowed to wait for a free slot.
# Requests beyond MAX_CONCURRENT_SESSIONS + MAX_QUEUE_LENGTH get HTTP 429.
MAX_QUEUE_LENGTH=20

# Maximum lifetime of an active session, in milliseconds.
CONNECTION_TIMEOUT_MS=600000

# Maximum time a request may wait in the queue, in milliseconds.
QUEUE_TIMEOUT_MS=600000

# Maximum time Chromium gets to publish its CDP endpoint, in milliseconds.
CHROME_STARTUP_TIMEOUT_MS=15000

# Time given to active sessions to finish after SIGTERM/SIGINT before they
# are closed, in milliseconds.
SHUTDOWN_GRACE_PERIOD_MS=10000

# Optional browser archive (.tar.gz containing a `chrome` executable) that
# Pinokio downloads into /opt/browsers on first start and launches instead of
# the bundled Chromium. You pick the build and accept its publisher's license.
# The archive's SHA-256 is logged after download; set BROWSER_ARCHIVE_SHA256
# to make Pinokio refuse anything else.
BROWSER_ARCHIVE_URL=
BROWSER_ARCHIVE_SHA256=

# Path to the browser binary. Leave empty to auto-detect: /opt/browser/chrome
# when a custom browser is mounted there, else the downloaded archive, else
# the bundled /usr/bin/chromium.
CHROME_PATH=

# Run Chromium with --headless=new.
CHROME_HEADLESS=true

# Add --no-sandbox. Required in most containers; see the README for the
# security implications.
CHROME_NO_SANDBOX=true

# Add --disable-dev-shm-usage. Keep enabled unless shm_size is large.
CHROME_DISABLE_DEV_SHM_USAGE=true

# Extra Chromium arguments, whitespace-separated.
# Example: CHROME_EXTRA_ARGS=--disable-web-security --window-size=1280,720
CHROME_EXTRA_ARGS=

# Log verbosity: trace, debug, info, warn, error.
LOG_LEVEL=info

# Timezone, inherited by Chromium processes.
TZ=Europe/Paris

# Default browser language, used for Chromium --lang and --accept-lang.
# Accepts a single tag or a colon-separated list such as fr-FR:fr.
# Clients may override it per session through the acceptLanguage launch option.
LANGUAGE=fr-FR
